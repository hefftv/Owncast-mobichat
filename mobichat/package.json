{
  "name": "mobichat",
  "version": "0.1.4",
  "private": true,
  "description": "Owncast plugin: chat above a docked stream on phones and tablets.",
  "license": "Unlicense",
  "scripts": {
    "build": "owncast-plugin build",
    "package": "owncast-plugin package",
    "test": "owncast-plugin build && node __tests__/plugin.test.js",
    "serve": "owncast-plugin build && owncast-plugin serve",
    "package:win": "npm run build && node make-ocpkg.js",
    "release:check": "npm run package:win && node scripts/verify-ocpkg.js"
  },
  "dependencies": {
    "@owncast/plugin-sdk": "^0.11.0"
  },
  "allowScripts": {
    "@owncast/plugin-sdk@0.11.0": true,
    "esbuild@0.24.2": true
  }
}
